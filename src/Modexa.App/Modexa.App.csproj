<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Modexa.App</RootNamespace>
    <AssemblyName>Modexa</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- The Modexa logo (the neon "MX" tile; assets\icon\modexa.ico, 16-256 px). -->
    <ApplicationIcon>assets\icon\modexa.ico</ApplicationIcon>

    <!-- Hardened single-file release knobs (mirrors the Backup Manager). -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Modexa.Core\Modexa.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- We use WinForms only via the explicit "WinForms" alias (FolderBrowserDialog), so drop its
         global usings to avoid Application/UserControl clashes with WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled OFL fonts, the window icon, the shop banners and the game art (icon + artwork per
         game, from each game's Steam store assets), embedded as WPF resources (pack://). -->
    <Resource Include="assets\fonts\*.ttf" />
    <Resource Include="assets\icon\modexa.ico" />
    <Resource Include="assets\icon\modexa-logo.png" />
    <Resource Include="assets\promo\*.jpg" />
    <Resource Include="assets\games\*.jpg" />
    <Resource Include="assets\games\*.png" />
  </ItemGroup>

</Project>
