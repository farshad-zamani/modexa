<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================================
         FREE TIER  —  "Stock": cold carbon with an ice-cyan accent, no gold.
         Every theme defines the same keys; ThemeService swaps the whole dictionary.
         Styles reference these via DynamicResource so switching is live.
         ============================================================================ -->

    <!-- Surfaces -->
    <Color x:Key="C.Bg.Base">#FF090B0F</Color>
    <Color x:Key="C.Bg.Panel">#FF11151C</Color>
    <Color x:Key="C.Bg.Elevated">#FF171E27</Color>
    <Color x:Key="C.Bg.Inset">#FF0C0F14</Color>
    <Color x:Key="C.Accent">#FF35D0E6</Color>
    <Color x:Key="C.Accent.Deep">#FF1C8FA3</Color>

    <SolidColorBrush x:Key="Bg.Base" Color="{DynamicResource C.Bg.Base}"/>
    <SolidColorBrush x:Key="Bg.Panel" Color="{DynamicResource C.Bg.Panel}"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="{DynamicResource C.Bg.Elevated}"/>
    <SolidColorBrush x:Key="Bg.Inset" Color="{DynamicResource C.Bg.Inset}"/>

    <SolidColorBrush x:Key="Bg.Hover" Color="#FF1D2530"/>
    <SolidColorBrush x:Key="Scrim" Color="#D9050709"/>

    <!-- Strokes -->
    <SolidColorBrush x:Key="Stroke.Subtle" Color="#FF202935"/>
    <SolidColorBrush x:Key="Stroke.Strong" Color="#FF2E3A4A"/>
    <SolidColorBrush x:Key="Stroke.Accent" Color="#FF35D0E6"/>

    <!-- Text (Muted kept >= 4.5:1 on Bg.Panel for small labels) -->
    <SolidColorBrush x:Key="Text.Primary" Color="#FFEAF1F8"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#FFA3AFBD"/>
    <SolidColorBrush x:Key="Text.Muted" Color="#FF7D8A9A"/>
    <SolidColorBrush x:Key="Text.OnAccent" Color="#FF04171B"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="Accent" Color="{DynamicResource C.Accent}"/>
    <SolidColorBrush x:Key="Accent.Deep" Color="{DynamicResource C.Accent.Deep}"/>
    <SolidColorBrush x:Key="Accent.Soft" Color="#2635D0E6"/>

    <LinearGradientBrush x:Key="Accent.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF48E0F0" Offset="0"/>
        <GradientStop Color="#FF1C8FA3" Offset="1"/>
    </LinearGradientBrush>

    <!-- Gold keys exist in every theme; in Free they are muted/hidden so gold decorations vanish. -->
    <SolidColorBrush x:Key="Gold" Color="#FF2B3645"/>
    <SolidColorBrush x:Key="Gold.Soft" Color="#00000000"/>
    <Color x:Key="C.Glow">#FF35D0E6</Color>

    <!-- Status -->
    <SolidColorBrush x:Key="Danger" Color="#FFE5484D"/>
    <SolidColorBrush x:Key="Danger.Soft" Color="#24E5484D"/>
    <SolidColorBrush x:Key="Success" Color="#FF3DD68C"/>
    <SolidColorBrush x:Key="Warning" Color="#FFE6B450"/>

    <!-- Window chrome glow intensity (used by the main window border effect). -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="Glow.Blur">26</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="Glow.Opacity">0.0</sys:Double>

</ResourceDictionary>
