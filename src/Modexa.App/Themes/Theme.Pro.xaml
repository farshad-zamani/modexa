<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================================
         PRO TIER  —  "Fully built": true black with molten gold and ambient glow.
         Brighter gold, warmer whites, strong edge glow on the window + key surfaces.
         ============================================================================ -->

    <Color x:Key="C.Bg.Base">#FF060504</Color>
    <Color x:Key="C.Bg.Panel">#FF100D08</Color>
    <Color x:Key="C.Bg.Elevated">#FF191309</Color>
    <Color x:Key="C.Bg.Inset">#FF0A0806</Color>
    <Color x:Key="C.Accent">#FFF5C451</Color>
    <Color x:Key="C.Accent.Deep">#FFB8862A</Color>

    <SolidColorBrush x:Key="Bg.Base" Color="{DynamicResource C.Bg.Base}"/>
    <SolidColorBrush x:Key="Bg.Panel" Color="{DynamicResource C.Bg.Panel}"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="{DynamicResource C.Bg.Elevated}"/>
    <SolidColorBrush x:Key="Bg.Inset" Color="{DynamicResource C.Bg.Inset}"/>

    <SolidColorBrush x:Key="Bg.Hover" Color="#FF221A0C"/>
    <SolidColorBrush x:Key="Scrim" Color="#E0050403"/>

    <SolidColorBrush x:Key="Stroke.Subtle" Color="#FF2E230B"/>
    <SolidColorBrush x:Key="Stroke.Strong" Color="#FF4A370F"/>
    <SolidColorBrush x:Key="Stroke.Accent" Color="#FFF5C451"/>

    <SolidColorBrush x:Key="Text.Primary" Color="#FFF8F0DE"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#FFCCC0A2"/>
    <SolidColorBrush x:Key="Text.Muted" Color="#FF9C8D69"/>
    <SolidColorBrush x:Key="Text.OnAccent" Color="#FF1C1304"/>

    <SolidColorBrush x:Key="Accent" Color="{DynamicResource C.Accent}"/>
    <SolidColorBrush x:Key="Accent.Deep" Color="{DynamicResource C.Accent.Deep}"/>
    <SolidColorBrush x:Key="Accent.Soft" Color="#30F5C451"/>

    <LinearGradientBrush x:Key="Accent.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFE08A" Offset="0"/>
        <GradientStop Color="#FFD9A23C" Offset="0.5"/>
        <GradientStop Color="#FF9B6F1E" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Gold" Color="#FFF5C451"/>
    <SolidColorBrush x:Key="Gold.Soft" Color="#40F5C451"/>
    <Color x:Key="C.Glow">#FFF5C451</Color>

    <SolidColorBrush x:Key="Danger" Color="#FFE5484D"/>
    <SolidColorBrush x:Key="Danger.Soft" Color="#24E5484D"/>
    <SolidColorBrush x:Key="Success" Color="#FF3DD68C"/>
    <SolidColorBrush x:Key="Warning" Color="#FFF5C451"/>

    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="Glow.Blur">44</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="Glow.Opacity">0.5</sys:Double>

</ResourceDictionary>
