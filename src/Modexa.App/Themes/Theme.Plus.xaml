<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================================
         PLUS TIER  —  "Tuned": carbon base with gold veins. The accent shifts from
         cyan toward warm gold; borders and active states pick up gold.
         ============================================================================ -->

    <Color x:Key="C.Bg.Base">#FF0A0A0C</Color>
    <Color x:Key="C.Bg.Panel">#FF14130F</Color>
    <Color x:Key="C.Bg.Elevated">#FF1B1A14</Color>
    <Color x:Key="C.Bg.Inset">#FF0D0C0A</Color>
    <Color x:Key="C.Accent">#FFDBA94C</Color>
    <Color x:Key="C.Accent.Deep">#FF8A6A26</Color>

    <SolidColorBrush x:Key="Bg.Base" Color="{DynamicResource C.Bg.Base}"/>
    <SolidColorBrush x:Key="Bg.Panel" Color="{DynamicResource C.Bg.Panel}"/>
    <SolidColorBrush x:Key="Bg.Elevated" Color="{DynamicResource C.Bg.Elevated}"/>
    <SolidColorBrush x:Key="Bg.Inset" Color="{DynamicResource C.Bg.Inset}"/>

    <SolidColorBrush x:Key="Bg.Hover" Color="#FF242219"/>
    <SolidColorBrush x:Key="Scrim" Color="#D9070605"/>

    <SolidColorBrush x:Key="Stroke.Subtle" Color="#FF2A2315"/>
    <SolidColorBrush x:Key="Stroke.Strong" Color="#FF3F331C"/>
    <SolidColorBrush x:Key="Stroke.Accent" Color="#FFDBA94C"/>

    <SolidColorBrush x:Key="Text.Primary" Color="#FFF3EEDF"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#FFBDB49D"/>
    <SolidColorBrush x:Key="Text.Muted" Color="#FF948A72"/>
    <SolidColorBrush x:Key="Text.OnAccent" Color="#FF1A1203"/>

    <SolidColorBrush x:Key="Accent" Color="{DynamicResource C.Accent}"/>
    <SolidColorBrush x:Key="Accent.Deep" Color="{DynamicResource C.Accent.Deep}"/>
    <SolidColorBrush x:Key="Accent.Soft" Color="#26DBA94C"/>

    <LinearGradientBrush x:Key="Accent.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF0CB6E" Offset="0"/>
        <GradientStop Color="#FFB07F2E" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Gold" Color="#FFDBA94C"/>
    <SolidColorBrush x:Key="Gold.Soft" Color="#30DBA94C"/>
    <Color x:Key="C.Glow">#FFDBA94C</Color>

    <SolidColorBrush x:Key="Danger" Color="#FFE5484D"/>
    <SolidColorBrush x:Key="Danger.Soft" Color="#24E5484D"/>
    <SolidColorBrush x:Key="Success" Color="#FF3DD68C"/>
    <SolidColorBrush x:Key="Warning" Color="#FFE6B450"/>

    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="Glow.Blur">30</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="Glow.Opacity">0.22</sys:Double>

</ResourceDictionary>
