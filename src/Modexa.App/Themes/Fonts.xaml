<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Bundled OFL fonts (see docs/CREDITS). Family names must match each font's internal name.

         English  : Chakra Petch (display + body) and Rajdhani (HUD labels, buttons) give the
                    techno/gaming feel while staying readable at small sizes.
         Persian  : Vazirmatn for everything (LanguageService swaps the active keys at runtime).

         Views only reference the active keys (Font.Display / Font.Body / Font.Hud) through
         DynamicResource, so switching language restyles every text live. -->

    <FontFamily x:Key="Font.En.Display">pack://application:,,,/assets/fonts/#Chakra Petch</FontFamily>
    <FontFamily x:Key="Font.En.Body">pack://application:,,,/assets/fonts/#Chakra Petch</FontFamily>
    <FontFamily x:Key="Font.En.Hud">pack://application:,,,/assets/fonts/#Rajdhani</FontFamily>
    <FontFamily x:Key="Font.Persian">pack://application:,,,/assets/fonts/#Vazirmatn</FontFamily>

    <!-- Active keys (English defaults; replaced for Persian by LanguageService). -->
    <FontFamily x:Key="Font.Display">pack://application:,,,/assets/fonts/#Chakra Petch</FontFamily>
    <FontFamily x:Key="Font.Body">pack://application:,,,/assets/fonts/#Chakra Petch</FontFamily>
    <FontFamily x:Key="Font.Hud">pack://application:,,,/assets/fonts/#Rajdhani</FontFamily>

    <!-- Icon font: Fluent on Windows 11, MDL2 on Windows 10 (same code points for what we use). -->
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

</ResourceDictionary>
