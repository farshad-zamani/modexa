<Window x:Class="Modexa.App.Views.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:Modexa.Core.I18n;assembly=Modexa.Core"
        Title="Modexa" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        UseLayoutRounding="True"
        FontFamily="{DynamicResource Font.Body}" FontSize="13"
        Foreground="{DynamicResource Text.Primary}">

    <Border Margin="16" CornerRadius="16" Background="{DynamicResource Bg.Panel}"
            BorderBrush="{DynamicResource Stroke.Strong}" BorderThickness="1"
            MouseLeftButtonDown="Root_MouseDown">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <!-- Close (top-trailing corner) -->
            <Button Style="{StaticResource IconButton}" Width="34" Height="34"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"
                    Background="Transparent" BorderBrush="Transparent" Click="Cancel_Click"
                    ToolTip="{Binding [Common_Close], Source={x:Static i18n:Loc.Instance}}">
                <Path Data="{StaticResource Glyph.Close}" Width="10" Height="10" Stretch="None" StrokeThickness="1.2"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Button>

            <StackPanel Margin="36,32,36,28">
                <!-- Header -->
                <Border Width="48" Height="48" CornerRadius="14" HorizontalAlignment="Center"
                        Background="{DynamicResource Accent.Gradient}">
                    <TextBlock x:Name="HeaderIcon" Style="{StaticResource Icon}" FontSize="20" Text="&#xE192;"
                               Foreground="{DynamicResource Text.OnAccent}"/>
                </Border>
                <TextBlock x:Name="HeaderText" Style="{StaticResource Display.H2}" FontSize="20"
                           Margin="0,16,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="SubText" Style="{StaticResource Text.Desc}" Margin="0,6,0,0"
                           HorizontalAlignment="Center" TextAlignment="Center" Visibility="Collapsed"/>

                <!-- Key input (license keys are Latin: always LTR) -->
                <TextBox x:Name="txtKey" Style="{StaticResource InputBox}" Margin="0,24,0,0"
                         MaxLength="40" TextChanged="Key_TextChanged"
                         HorizontalContentAlignment="Center" FlowDirection="LeftToRight"
                         NumberSubstitution.Substitution="European"
                         CharacterCasing="Upper"/>
                <TextBlock x:Name="KeyHint" Style="{StaticResource Label.Caps}" FontFamily="{DynamicResource Font.En.Hud}"
                           Margin="0,8,0,0" HorizontalAlignment="Center" FlowDirection="LeftToRight"
                           NumberSubstitution.Substitution="European"
                           Text="MDX-XXXXXX-XXXXXX-XXXXXX-XXXXXX-PLUS"/>

                <!-- Status: reserved height so the dialog doesn't jump between states -->
                <StackPanel MinHeight="52" Margin="0,10,0,0" VerticalAlignment="Center">
                    <ProgressBar x:Name="bar" Width="300" Margin="0,6,0,0" Minimum="0" Maximum="100"
                                 Visibility="Collapsed"/>
                    <TextBlock x:Name="lblMsg" Margin="0,8,0,0" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" LineHeight="20" Visibility="Collapsed"/>
                </StackPanel>

                <!-- Actions -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnCancel" Style="{StaticResource GhostButton}" Height="44"
                            HorizontalAlignment="Stretch" IsCancel="True" Click="Cancel_Click"
                            Content="{Binding [Common_Cancel], Source={x:Static i18n:Loc.Instance}}"/>
                    <Button x:Name="btnActivate" Grid.Column="2" Style="{StaticResource PrimaryButton}" Height="44"
                            HorizontalAlignment="Stretch" IsDefault="True" Click="Activate_Click"
                            Content="{Binding [License_Activate], Source={x:Static i18n:Loc.Instance}}"/>
                </Grid>

                <TextBlock Margin="0,20,0,0" HorizontalAlignment="Center">
                    <Hyperlink NavigateUri="https://rockstargame.ir/shop/" RequestNavigate="Hyperlink_Navigate"
                               Foreground="{DynamicResource Accent}" TextDecorations="None">
                        <!-- Run.Text binds TwoWay by default; the localization indexer is read-only. -->
                        <Run Text="{Binding [License_Buy], Source={x:Static i18n:Loc.Instance}, Mode=OneWay}"/>
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</Window>
