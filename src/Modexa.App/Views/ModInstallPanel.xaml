<UserControl x:Class="Modexa.App.Views.ModInstallPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="clr-namespace:Modexa.Core.I18n;assembly=Modexa.Core"
             AllowDrop="True" Drop="Root_Drop" DragOver="Root_DragOver" DragLeave="Root_DragLeave">
    <!-- "Install mods" section of a game page: drop zone / file picker, then the mods installed
         into this game folder with an uninstall button each. -->
    <StackPanel>
        <TextBlock Style="{StaticResource Display.H2}" Margin="0,32,0,0"
                   Text="{Binding [Mods_Section_Title], Source={x:Static i18n:Loc.Instance}}"/>
        <TextBlock x:Name="SectionDesc" Style="{StaticResource Text.Desc}" Margin="0,4,0,14"/>

        <!-- Drop zone -->
        <Grid MinHeight="132">
            <Border x:Name="DropBg" CornerRadius="14" Background="{DynamicResource Bg.Panel}"/>
            <Rectangle x:Name="DropOutline" RadiusX="14" RadiusY="14" StrokeThickness="1.5"
                       StrokeDashArray="5 4" Stroke="{DynamicResource Stroke.Strong}"
                       SnapsToDevicePixels="True" IsHitTestVisible="False"/>
            <Grid Margin="22,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="52" Height="52" CornerRadius="26" VerticalAlignment="Center"
                        Background="{DynamicResource Accent.Soft}">
                    <TextBlock Style="{StaticResource Icon}" FontSize="22"
                               Foreground="{DynamicResource Accent}" Text="&#xE896;"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="18,0,18,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.CardTitle}" FontSize="16"
                               Text="{Binding [Mods_Drop_Here], Source={x:Static i18n:Loc.Instance}}"/>
                    <TextBlock x:Name="DropHint" Style="{StaticResource Text.Desc}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button x:Name="BtnChoose" Grid.Column="2" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"
                        Click="Choose_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" FontSize="15" Text="&#xE8E5;"/>
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding [Mods_ChooseFile], Source={x:Static i18n:Loc.Instance}}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- Installed into this game -->
        <StackPanel Orientation="Horizontal" Margin="0,24,0,12">
            <TextBlock Style="{StaticResource Display.H2}" VerticalAlignment="Center"
                       Text="{Binding [Mods_InstalledHere], Source={x:Static i18n:Loc.Instance}}"/>
            <Border Style="{StaticResource Chip}" Margin="10,0,0,0" MinHeight="22" Padding="8,0" VerticalAlignment="Center">
                <TextBlock x:Name="CountText" FlowDirection="LeftToRight" NumberSubstitution.Substitution="European"
                           Style="{StaticResource Label.Caps}" FontSize="12" FontFamily="{DynamicResource Font.En.Hud}"
                           VerticalAlignment="Center" Text="0"/>
            </Border>
        </StackPanel>
        <ItemsControl x:Name="InstalledList" Focusable="False"/>
        <Border x:Name="EmptyNote" Style="{StaticResource Card}" Padding="20,16">
            <TextBlock Style="{StaticResource Text.Desc}"
                       Text="{Binding [Mods_NoneHere], Source={x:Static i18n:Loc.Instance}}"/>
        </Border>
    </StackPanel>
</UserControl>
