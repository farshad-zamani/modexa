<Window x:Class="Modexa.App.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modexa" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        UseLayoutRounding="True"
        FontFamily="{DynamicResource Font.Body}" FontSize="13"
        Foreground="{DynamicResource Text.Primary}">

    <Border Margin="16" CornerRadius="16" Background="{DynamicResource Bg.Dialog}"
            BorderBrush="{DynamicResource Stroke.Strong}" BorderThickness="1"
            MouseLeftButtonDown="Root_MouseDown">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <Grid Margin="28,26,28,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="IconBg" Grid.RowSpan="2" Width="40" Height="40" CornerRadius="20"
                    VerticalAlignment="Top" Background="{DynamicResource Accent.Soft}">
                <TextBlock x:Name="IconGlyph" Style="{StaticResource Icon}" FontSize="18"
                           Foreground="{DynamicResource Accent}" Text="&#xE946;"/>
            </Border>

            <TextBlock x:Name="TitleText" Grid.Column="1" Margin="16,2,0,0"
                       Style="{StaticResource Display.H2}" TextWrapping="Wrap"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="16,8,0,0">
                <TextBlock x:Name="MessageText" Style="{StaticResource Text.Desc}" FontSize="14" LineHeight="22"/>
                <ComboBox x:Name="ChoiceBox" Margin="0,14,0,0" Visibility="Collapsed" MaxDropDownHeight="320"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,26,0,0">
                <Button x:Name="BtnSecondary" Style="{StaticResource GhostButton}" MinWidth="96"
                        IsCancel="True" Click="Secondary_Click" Visibility="Collapsed"/>
                <Button x:Name="BtnPrimary" Style="{StaticResource PrimaryButton}" MinWidth="96"
                        Margin="10,0,0,0" IsDefault="True" Click="Primary_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
