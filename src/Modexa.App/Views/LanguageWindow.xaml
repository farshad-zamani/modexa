<Window x:Class="Modexa.App.Views.LanguageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modexa" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        UseLayoutRounding="True"
        FontFamily="{DynamicResource Font.En.Body}" FontSize="13"
        Foreground="{DynamicResource Text.Primary}">

    <Window.Resources>
        <Style x:Key="LangCard" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="132"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" CornerRadius="14" Background="{DynamicResource Bg.Inset}"
                                BorderBrush="{DynamicResource Stroke.Strong}" BorderThickness="1.5">
                            <Grid>
                                <!-- check badge -->
                                <Border x:Name="check" Width="22" Height="22" CornerRadius="11" Margin="12"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Background="{DynamicResource Accent}" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="11" Text="&#xE73E;"
                                               Foreground="{DynamicResource Text.OnAccent}"/>
                                </Border>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Stroke.Accent}"/>
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Bg.Elevated}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Accent.Soft}"/>
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="16" CornerRadius="18" Background="{DynamicResource Bg.Dialog}"
            BorderBrush="{DynamicResource Stroke.Strong}" BorderThickness="1"
            MouseLeftButtonDown="Root_MouseDown">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <StackPanel Margin="40,36,40,32">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="MODE" FontFamily="{DynamicResource Font.En.Display}" FontWeight="Bold"
                           FontSize="34" Foreground="{DynamicResource Text.Primary}"/>
                <TextBlock Text="XA" FontFamily="{DynamicResource Font.En.Display}" FontWeight="Bold"
                           FontSize="34" Foreground="{DynamicResource Accent}"/>
            </StackPanel>

            <TextBlock Text="Choose your language" FontFamily="{DynamicResource Font.En.Hud}"
                       FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"
                       Foreground="{DynamicResource Text.Primary}"/>
            <TextBlock Text="زبان خود را انتخاب کنید" FontFamily="{DynamicResource Font.Persian}"
                       FontSize="14" Margin="0,4,0,0" HorizontalAlignment="Center"
                       Foreground="{DynamicResource Text.Secondary}"/>

            <Grid Margin="0,28,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ToggleButton x:Name="btnEn" Grid.Column="0" Click="Lang_Click" Tag="en"
                              Style="{StaticResource LangCard}">
                    <StackPanel>
                        <TextBlock Text="EN" FontFamily="{DynamicResource Font.En.Display}" FontWeight="Bold"
                                   FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="English" FontFamily="{DynamicResource Font.En.Hud}" FontSize="16"
                                   FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"
                                   Foreground="{DynamicResource Text.Secondary}"/>
                    </StackPanel>
                </ToggleButton>

                <ToggleButton x:Name="btnFa" Grid.Column="2" Click="Lang_Click" Tag="fa"
                              Style="{StaticResource LangCard}">
                    <StackPanel>
                        <TextBlock Text="فا" FontFamily="{DynamicResource Font.Persian}" FontWeight="Bold"
                                   FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="فارسی" FontFamily="{DynamicResource Font.Persian}" FontSize="15"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"
                                   Foreground="{DynamicResource Text.Secondary}"/>
                    </StackPanel>
                </ToggleButton>
            </Grid>

            <Button x:Name="btnContinue" Click="Continue_Click" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Height="44" Width="220" HorizontalAlignment="Center"
                    Margin="0,28,0,0" IsEnabled="False">
                <TextBlock x:Name="ContinueText" Text="Continue"/>
            </Button>
        </StackPanel>
    </Border>
</Window>
