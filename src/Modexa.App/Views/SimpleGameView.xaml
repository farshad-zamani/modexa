<UserControl x:Class="Modexa.App.Views.SimpleGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Modexa.App.Views"
             xmlns:i18n="clr-namespace:Modexa.Core.I18n;assembly=Modexa.Core">

    <Grid Background="Transparent">
        <ScrollViewer Style="{StaticResource PageScroll}">
            <StackPanel Style="{StaticResource PageContent}">

                <!-- Header -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource IconButton}" VerticalAlignment="Center" Margin="0,0,16,0"
                            Click="Back_Click"
                            ToolTip="{Binding [Common_Back], Source={x:Static i18n:Loc.Instance}}">
                        <Path Data="{StaticResource Glyph.Back}" Width="14" Height="14" Stretch="None"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Style="{StaticResource Display.H1}"
                                   FontFamily="{DynamicResource Font.En.Display}" Text="Game"/>
                        <TextBlock Style="{StaticResource Text.Subtitle}" Margin="0,2,0,0"
                                   Text="{Binding [Simple_Subtitle], Source={x:Static i18n:Loc.Instance}}"/>
                    </StackPanel>
                </Grid>

                <!-- Game folder -->
                <Border Style="{StaticResource Card}" Margin="0,24,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label.Caps}"
                                   Text="{Binding [Common_GameFolder], Source={x:Static i18n:Loc.Instance}}"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Height="40" CornerRadius="10" Padding="14,0"
                                    Background="{DynamicResource Bg.Inset}"
                                    BorderBrush="{DynamicResource Stroke.Subtle}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Icon}" FontSize="15"
                                               Foreground="{DynamicResource Text.Muted}" Text="&#xE8B7;"/>
                                    <TextBlock x:Name="FolderText" Grid.Column="1" Margin="10,0,0,0"
                                               VerticalAlignment="Center" FontSize="13"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="12,0,0,0"
                                    Click="Browse_Click"
                                    Content="{Binding [Common_Browse], Source={x:Static i18n:Loc.Instance}}"/>
                        </Grid>
                        <WrapPanel Margin="0,14,0,0">
                            <Border x:Name="VersionChip" Style="{StaticResource Chip}" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Label.Caps}" VerticalAlignment="Center"
                                               Text="{Binding [Common_Version], Source={x:Static i18n:Loc.Instance}}"/>
                                    <TextBlock x:Name="VersionText" Style="{StaticResource Hud.Value}"
                                               FontFamily="{DynamicResource Font.En.Hud}" FlowDirection="LeftToRight"
                                               NumberSubstitution.Substitution="European"
                                               VerticalAlignment="Center" Margin="10,0,0,0" Text="—"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Prepare -->
                <TextBlock Style="{StaticResource Display.H2}" Margin="0,32,0,0"
                           Text="{Binding [GtaV_Prepare_Title], Source={x:Static i18n:Loc.Instance}}"/>
                <TextBlock Style="{StaticResource Text.Desc}" Margin="0,4,0,14"
                           Text="{Binding [Simple_Prepare_Desc], Source={x:Static i18n:Loc.Instance}}"/>

                <local:StepCard x:Name="StepRunner" Glyph="&#xE945;" Click="Runner_Click"
                                Title="{Binding [Simple_Step_Runner], Source={x:Static i18n:Loc.Instance}}"
                                Description="{Binding [Simple_Step_Runner_Desc], Source={x:Static i18n:Loc.Instance}}"
                                ActionText="{Binding [Common_Install], Source={x:Static i18n:Loc.Instance}}"/>

                <!-- Maintenance -->
                <TextBlock Style="{StaticResource Display.H2}" Margin="0,32,0,14"
                           Text="{Binding [Common_Maintenance], Source={x:Static i18n:Loc.Instance}}"/>
                <Border Style="{StaticResource Card}" Padding="20,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Text.CardTitle}"
                                       Text="{Binding [GtaV_Revert], Source={x:Static i18n:Loc.Instance}}"/>
                            <TextBlock Style="{StaticResource Text.Desc}" Margin="0,4,0,0"
                                       Text="{Binding [GtaV_Revert_Desc], Source={x:Static i18n:Loc.Instance}}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource DangerButton}" MinWidth="112"
                                VerticalAlignment="Center" Click="Revert_Click"
                                Content="{Binding [Common_Revert], Source={x:Static i18n:Loc.Instance}}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Progress overlay -->
        <Grid x:Name="Overlay" Background="{DynamicResource Scrim}" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Width="420" Padding="28,26"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="OverlayPhase" Style="{StaticResource Display.H2}" HorizontalAlignment="Center"/>
                    <ProgressBar x:Name="OverlayBar" Margin="0,20,0,0" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="OverlayPercent" Style="{StaticResource Hud.Value}" Margin="0,10,0,0"
                               FontFamily="{DynamicResource Font.En.Hud}"
                               Foreground="{DynamicResource Text.Secondary}" HorizontalAlignment="Center"/>
                    <Button x:Name="OverlayCancel" Style="{StaticResource GhostButton}" Margin="0,20,0,0"
                            HorizontalAlignment="Center" MinWidth="112" Click="Cancel_Click"
                            Content="{Binding [Common_Cancel], Source={x:Static i18n:Loc.Instance}}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
