<UserControl x:Class="Modexa.App.Views.BusyOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="clr-namespace:Modexa.Core.I18n;assembly=Modexa.Core"
             Visibility="Collapsed">
    <!-- Progress card over a page: what is being installed (icon + name), the phase, which step of
         how many, a percentage with the time left, and the file / archive being worked on. -->
    <Grid Background="{DynamicResource Scrim}">
        <Border Style="{StaticResource Card}" Width="480" Padding="28,24"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <Grid x:Name="TitleRow" Margin="0,0,0,18" Visibility="Collapsed" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="IconFrame" Width="48" Height="48" CornerRadius="11" Margin="0,0,14,0"
                            Background="{DynamicResource Bg.Inset}" Visibility="Collapsed">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,48,48" RadiusX="11" RadiusY="11"/>
                        </Border.Clip>
                        <Image x:Name="IconImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" FlowDirection="LeftToRight"/>
                    </Border>
                    <TextBlock x:Name="TitleText" Grid.Column="1" Style="{StaticResource Text.CardTitle}" FontSize="16"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="340"/>
                </Grid>

                <TextBlock x:Name="PhaseText" Style="{StaticResource Display.H2}" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock x:Name="StepText" Style="{StaticResource Text.Desc}" HorizontalAlignment="Center"
                           Margin="0,4,0,0" Visibility="Collapsed"/>

                <ProgressBar x:Name="Bar" Margin="0,18,0,0" Minimum="0" Maximum="100"/>
                <Grid Margin="0,10,0,0">
                    <TextBlock x:Name="PercentText" Style="{StaticResource Hud.Value}" HorizontalAlignment="Left"
                               FontFamily="{DynamicResource Font.En.Hud}" Foreground="{DynamicResource Text.Secondary}"
                               FlowDirection="LeftToRight" NumberSubstitution.Substitution="European"/>
                    <TextBlock x:Name="EtaText" Style="{StaticResource Text.Desc}" HorizontalAlignment="Right"
                               VerticalAlignment="Center" FontSize="12"/>
                </Grid>
                <TextBlock x:Name="DetailText" Style="{StaticResource Text.Desc}" FontSize="12" Margin="0,8,0,0"
                           HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420"
                           FlowDirection="LeftToRight" NumberSubstitution.Substitution="European"
                           Foreground="{DynamicResource Text.Muted}"/>

                <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" Margin="0,20,0,0"
                        HorizontalAlignment="Center" MinWidth="112" Click="Cancel_Click" Visibility="Collapsed"
                        Content="{Binding [Common_Cancel], Source={x:Static i18n:Loc.Instance}}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
