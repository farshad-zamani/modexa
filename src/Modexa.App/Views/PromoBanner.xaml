<UserControl x:Class="Modexa.App.Views.PromoBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="clr-namespace:Modexa.Core.I18n;assembly=Modexa.Core"
             Cursor="Hand" Focusable="True" KeyboardNavigation.IsTabStop="True"
             MouseLeftButtonUp="Root_Click" KeyDown="Root_KeyDown"
             MouseEnter="Root_MouseEnter" MouseLeave="Root_MouseLeave">
    <!-- A product of the client's shop: artwork, name, a two-line pitch and a link to its page.
         The whole card is the link. -->
    <Border x:Name="Frame" CornerRadius="14" Height="180" Background="{DynamicResource Bg.Panel}"
            BorderBrush="{DynamicResource Stroke.Subtle}" BorderThickness="1" SizeChanged="Frame_SizeChanged">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Lift"/>
        </Border.RenderTransform>
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- 208 x 180 matches the artwork (1500 x 1300): nothing is cropped. -->
                <ColumnDefinition Width="208"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Artwork never mirrors in Persian. -->
            <Image x:Name="Art" Stretch="UniformToFill" FlowDirection="LeftToRight"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <Border Width="1" HorizontalAlignment="Right" Background="{DynamicResource Stroke.Subtle}"/>

            <Grid Grid.Column="1" Margin="18,14,18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource Accent}"
                               Text="&#xE719;" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource Label.Caps}" Margin="6,0,0,0" Foreground="{DynamicResource Accent}"
                               VerticalAlignment="Center"
                               Text="{Binding [Promo_Label], Source={x:Static i18n:Loc.Instance}}"/>
                </StackPanel>
                <TextBlock x:Name="TitleText" Grid.Row="1" Style="{StaticResource Text.CardTitle}" FontSize="15.5"
                           Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="44"/>
                <TextBlock x:Name="BodyText" Grid.Row="2" Style="{StaticResource Text.Desc}" FontSize="12.5"
                           Margin="0,5,0,0" TextWrapping="Wrap" TextTrimming="WordEllipsis"/>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock x:Name="LinkText" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource Accent}"
                               VerticalAlignment="Center"
                               Text="{Binding [Promo_View], Source={x:Static i18n:Loc.Instance}}"/>
                    <TextBlock Style="{StaticResource Icon}" FontSize="11" Margin="7,1,0,0" Foreground="{DynamicResource Accent}"
                               Text="&#xE8A7;" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
