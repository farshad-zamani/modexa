<UserControl x:Class="Modexa.App.Views.StepCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- One "prepare" step: [icon tile] [title + description] [action]. Shared by every game page so
         all steps line up on the same grid. -->
    <Border Style="{StaticResource Card}" Padding="20,18">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource IconTile}">
                <TextBlock Style="{StaticResource Icon}" FontSize="18" Foreground="{DynamicResource Accent}"
                           Text="{Binding Glyph, ElementName=Root}"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="16,0,20,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.CardTitle}" VerticalAlignment="Center"
                               Text="{Binding Title, ElementName=Root}"/>
                    <Border x:Name="DoneChip" Style="{StaticResource TierChip}" MinHeight="22" Padding="8,0"
                            Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="10" Text="&#xE73E;"
                                       Foreground="{DynamicResource Accent}"/>
                            <TextBlock x:Name="DoneText" Margin="6,0,0,0" FontFamily="{DynamicResource Font.Hud}"
                                       FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Accent}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Style="{StaticResource Text.Desc}" Margin="0,4,0,0"
                           Text="{Binding Description, ElementName=Root}"/>
            </StackPanel>

            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" MinWidth="128"
                    VerticalAlignment="Center" Click="Action_Click"
                    Content="{Binding ActionText, ElementName=Root}"/>
        </Grid>
    </Border>
</UserControl>
