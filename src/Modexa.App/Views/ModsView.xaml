<UserControl x:Class="Modexa.App.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="clr-namespace:Modexa.Core.I18n;assembly=Modexa.Core"
             AllowDrop="True" Drop="Root_Drop" DragOver="Root_DragOver" DragLeave="Root_DragLeave">

    <Grid Background="Transparent">
        <ScrollViewer Style="{StaticResource PageScroll}">
            <StackPanel Style="{StaticResource PageContent}">

                <!-- ===== Header ===== -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource IconButton}" VerticalAlignment="Center" Margin="0,0,16,0"
                            Click="Back_Click"
                            ToolTip="{Binding [Common_Back], Source={x:Static i18n:Loc.Instance}}">
                        <Path Data="{StaticResource Glyph.Back}" Width="14" Height="14" Stretch="None"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Display.H1}"
                                   Text="{Binding [Mods_Title], Source={x:Static i18n:Loc.Instance}}"/>
                        <TextBlock Style="{StaticResource Text.Subtitle}" Margin="0,2,0,0"
                                   Text="{Binding [Mods_Subtitle], Source={x:Static i18n:Loc.Instance}}"/>
                    </StackPanel>
                </Grid>

                <!-- ===== Drop zone ===== -->
                <Grid Margin="0,24,0,0" MinHeight="196">
                    <Border x:Name="DropBg" CornerRadius="14" Background="{DynamicResource Bg.Panel}"/>
                    <!-- dashed outline -->
                    <Rectangle x:Name="DropOutline" RadiusX="14" RadiusY="14" StrokeThickness="1.5"
                               StrokeDashArray="5 4" Stroke="{DynamicResource Stroke.Strong}"
                               SnapsToDevicePixels="True" IsHitTestVisible="False"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                        <Border Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center"
                                Background="{DynamicResource Accent.Soft}">
                            <TextBlock Style="{StaticResource Icon}" FontSize="24"
                                       Foreground="{DynamicResource Accent}" Text="&#xE896;"/>
                        </Border>
                        <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                                   Style="{StaticResource Text.CardTitle}" FontSize="16"
                                   Text="{Binding [Mods_Drop], Source={x:Static i18n:Loc.Instance}}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Click="Browse_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="15" Text="&#xE8E5;"/>
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                               Text="{Binding [Mods_Browse], Source={x:Static i18n:Loc.Instance}}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="InstallAny_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="15" Text="&#xE710;"/>
                                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center"
                                               Text="{Binding [Mods_InstallAny], Source={x:Static i18n:Loc.Instance}}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ===== Modexa Pro (upsell / status) ===== -->
                <Border x:Name="ProCard" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource Accent.Gradient}"
                                VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" FontSize="18" Text="&#xE734;"
                                       Foreground="{DynamicResource Text.OnAccent}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,20,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Text.CardTitle}"
                                       Text="{Binding [Pro_Card_Title], Source={x:Static i18n:Loc.Instance}}"/>
                            <TextBlock x:Name="ProCardDesc" Style="{StaticResource Text.Desc}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button x:Name="BtnActivatePro" Grid.Column="2" Style="{StaticResource PrimaryButton}"
                                VerticalAlignment="Center" Click="ActivatePro_Click"
                                Content="{Binding [Pro_Activate], Source={x:Static i18n:Loc.Instance}}"/>
                        <Border x:Name="ProActiveChip" Grid.Column="2" Style="{StaticResource TierChip}"
                                VerticalAlignment="Center" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE73E;"
                                           Foreground="{DynamicResource Accent}"/>
                                <TextBlock Margin="8,0,0,0" FontFamily="{DynamicResource Font.Hud}" FontWeight="SemiBold"
                                           FontSize="14" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"
                                           Text="{Binding [Pro_Active], Source={x:Static i18n:Loc.Instance}}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ===== Installed ===== -->
                <StackPanel Orientation="Horizontal" Margin="0,32,0,14">
                    <TextBlock Style="{StaticResource Display.H2}" VerticalAlignment="Center"
                               Text="{Binding [Mods_Installed], Source={x:Static i18n:Loc.Instance}}"/>
                    <Border Style="{StaticResource Chip}" Margin="10,0,0,0" MinHeight="22" Padding="8,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="CountText" FlowDirection="LeftToRight" NumberSubstitution.Substitution="European" Style="{StaticResource Label.Caps}" FontSize="12"
                                   FontFamily="{DynamicResource Font.En.Hud}" VerticalAlignment="Center" Text="0"/>
                    </Border>
                </StackPanel>

                <ItemsControl x:Name="InstalledList" Focusable="False"/>

                <!-- Empty state -->
                <Border x:Name="EmptyNote" Style="{StaticResource Card}" Padding="24" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Icon}" FontSize="22" Foreground="{DynamicResource Text.Muted}"
                                   Text="&#xE7B8;"/>
                        <TextBlock Style="{StaticResource Text.CardTitle}" Margin="0,10,0,0" HorizontalAlignment="Center"
                                   Text="{Binding [Mods_Empty], Source={x:Static i18n:Loc.Instance}}"/>
                        <TextBlock Style="{StaticResource Text.Desc}" Margin="0,4,0,0" HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Text="{Binding [Mods_Empty_Hint], Source={x:Static i18n:Loc.Instance}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Busy overlay ===== -->
        <Grid x:Name="Overlay" Background="{DynamicResource Scrim}" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Width="400" Padding="28,26"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="OverlayText" Style="{StaticResource Display.H2}" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Text="{Binding [Dl_Installing], Source={x:Static i18n:Loc.Instance}}"/>
                    <ProgressBar x:Name="OverlayBar" Margin="0,20,0,4"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
