<UserControl x:Class="Modexa.App.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="clr-namespace:Modexa.Core.I18n;assembly=Modexa.Core">

    <!-- My Mods: every mod installed on every game, in one place. View-only; with Pro the list also
         offers management (uninstall, open the game folder). Installing happens on each game's page. -->
    <Grid Background="Transparent">
        <ScrollViewer Style="{StaticResource PageScroll}">
            <StackPanel Style="{StaticResource PageContent}">

                <!-- ===== Header ===== -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource IconButton}" VerticalAlignment="Center" Margin="0,0,16,0"
                            Click="Back_Click"
                            ToolTip="{Binding [Common_Back], Source={x:Static i18n:Loc.Instance}}">
                        <Path Data="{StaticResource Glyph.Back}" Width="14" Height="14" Stretch="None"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Display.H1}"
                                   Text="{Binding [Mods_Title], Source={x:Static i18n:Loc.Instance}}"/>
                        <TextBlock Style="{StaticResource Text.Subtitle}" Margin="0,2,0,0"
                                   Text="{Binding [Mods_Subtitle], Source={x:Static i18n:Loc.Instance}}"/>
                    </StackPanel>
                </Grid>

                <!-- ===== Summary ===== -->
                <Border Style="{StaticResource Card}" Margin="0,24,0,0" Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource Accent.Soft}"
                                VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" FontSize="18" Text="&#xE946;"
                                       Foreground="{DynamicResource Accent}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="SummaryText" Style="{StaticResource Text.CardTitle}"/>
                            <TextBlock Style="{StaticResource Text.Desc}" Margin="0,4,0,0"
                                       Text="{Binding [Mods_HowToInstall], Source={x:Static i18n:Loc.Instance}}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== Modexa Pro (upsell / status) ===== -->
                <Border x:Name="ProCard" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="20,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource Accent.Gradient}"
                                VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" FontSize="18" Text="&#xE734;"
                                       Foreground="{DynamicResource Text.OnAccent}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,20,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Text.CardTitle}"
                                       Text="{Binding [Pro_Card_Title], Source={x:Static i18n:Loc.Instance}}"/>
                            <TextBlock x:Name="ProCardDesc" Style="{StaticResource Text.Desc}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button x:Name="BtnActivatePro" Grid.Column="2" Style="{StaticResource PrimaryButton}"
                                VerticalAlignment="Center" Click="ActivatePro_Click"
                                Content="{Binding [Pro_Activate], Source={x:Static i18n:Loc.Instance}}"/>
                        <Border x:Name="ProActiveChip" Grid.Column="2" Style="{StaticResource TierChip}"
                                VerticalAlignment="Center" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE73E;"
                                           Foreground="{DynamicResource Accent}"/>
                                <TextBlock Margin="8,0,0,0" FontFamily="{DynamicResource Font.Hud}" FontWeight="SemiBold"
                                           FontSize="14" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"
                                           Text="{Binding [Pro_Active], Source={x:Static i18n:Loc.Instance}}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ===== All installed mods, grouped by game ===== -->
                <StackPanel x:Name="Groups" Margin="0,8,0,0"/>

                <!-- Empty state -->
                <Border x:Name="EmptyNote" Style="{StaticResource Card}" Padding="24" Margin="0,24,0,0" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Icon}" FontSize="22" Foreground="{DynamicResource Text.Muted}"
                                   Text="&#xE7B8;"/>
                        <TextBlock Style="{StaticResource Text.CardTitle}" Margin="0,10,0,0" HorizontalAlignment="Center"
                                   Text="{Binding [Mods_Empty], Source={x:Static i18n:Loc.Instance}}"/>
                        <TextBlock Style="{StaticResource Text.Desc}" Margin="0,4,0,0" HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Text="{Binding [Mods_Empty_Hint], Source={x:Static i18n:Loc.Instance}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Busy overlay ===== -->
        <Grid x:Name="Overlay" Background="{DynamicResource Scrim}" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Width="400" Padding="28,26"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Style="{StaticResource Display.H2}" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Text="{Binding [Mods_Uninstalling], Source={x:Static i18n:Loc.Instance}}"/>
                    <ProgressBar x:Name="OverlayBar" Margin="0,20,0,4"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
