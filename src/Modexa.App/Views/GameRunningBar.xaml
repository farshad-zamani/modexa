<UserControl x:Class="Modexa.App.Views.GameRunningBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i18n="clr-namespace:Modexa.Core.I18n;assembly=Modexa.Core">
    <!-- Shown only while the game is open: mods can't be installed or removed then. One click closes it. -->
    <Border x:Name="Bar" Visibility="Collapsed" CornerRadius="12" Padding="16,10"
            Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Warning}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Icon}" FontSize="18" Text="&#xE7BA;" VerticalAlignment="Center"
                       Foreground="{DynamicResource Warning}"/>
            <TextBlock Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource Text.Primary}"
                       Text="{Binding [Game_Running_Bar], Source={x:Static i18n:Loc.Instance}}"/>
            <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource GhostButton.Small}" VerticalAlignment="Center"
                    Click="Close_Click"
                    Content="{Binding [Game_Close], Source={x:Static i18n:Loc.Instance}}"/>
        </Grid>
    </Border>
</UserControl>
