<UserControl x:Class="Modexa.App.Views.SignatureBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="LeftToRight">
    <!-- Maker's mark at the bottom of the window: "Developed by cloudtart.com · Made for wtmod.com". -->
    <TextBlock Style="{StaticResource Signature}" TextOptions.TextFormattingMode="Ideal">
        <Run Text="Developed by "/><Hyperlink NavigateUri="https://cloudtart.com" RequestNavigate="Link_Navigate" ToolTip="https://cloudtart.com"
                   Foreground="{DynamicResource Accent}" TextDecorations="None"><Run Text="cloudtart.com"/></Hyperlink><Run Text="  ·  Made for "/><Hyperlink NavigateUri="https://wtmod.com" RequestNavigate="Link_Navigate" ToolTip="https://wtmod.com"
                   Foreground="{DynamicResource Accent}" TextDecorations="None"><Run Text="wtmod.com"/></Hyperlink>
    </TextBlock>
</UserControl>
