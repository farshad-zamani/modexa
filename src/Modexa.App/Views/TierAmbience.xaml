<UserControl x:Class="Modexa.App.Views.TierAmbience"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" Focusable="False" ClipToBounds="True">
    <!-- Decorative background behind every page.
           Free: nothing.
           Plus: gold veins that breathe, with a few soft gold beads gliding back and forth on them.
           Pro : brighter veins with a soft glow, more and brighter beads (with halos), a drifting
                 aurora and rising embers.
         Pure brushes/transforms (no blur effects) and a 30 fps cap keep it cheap. -->
    <Grid x:Name="Root" Visibility="Collapsed">

        <!-- Aurora (Pro) -->
        <Canvas x:Name="AuroraLayer" Opacity="0">
            <Ellipse x:Name="AuroraA" Width="1100" Height="560" Canvas.Left="-200" Canvas.Top="-300">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{DynamicResource C.Glow}" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="AuroraATx"/>
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="AuroraB" Width="900" Height="480" Canvas.Top="-260">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FFB8862A" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="AuroraBTx"/>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>

        <!-- Soft wide under-stroke of every vein (Pro): reads as a glow without a blur effect. -->
        <Canvas x:Name="GlowLayer" Opacity="0"/>

        <!-- Gold veins. Geometry is defined in a 1000x600 space and scaled in code with a geometry
             transform, so strokes stay thin at any window size. -->
        <Canvas x:Name="VeinLayer" Opacity="0"/>

        <!-- Gold beads gliding back and forth along the veins. -->
        <Canvas x:Name="BeadLayer" Opacity="0"/>

        <!-- Embers (Pro) -->
        <Canvas x:Name="EmberLayer" Opacity="0"/>
    </Grid>
</UserControl>
